.env
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
# Salidas de trabajo: RFQs, informes de validacion y la base de datos activa.
# Las bases de datos archivadas de cada tanda viven en evaluation/results/ y SI
# se versionan: son la evidencia de la memoria.
outputs/**
!outputs/.gitkeep
evaluation/cases/*.result.txt
~$*

# Volcados temporales de las sesiones de trabajo. El registro de los
# experimentos, que es lo que hay que conservar, esta en
# docs/REGISTRO_EXPERIMENTOS.md, y las cifras son reconstruibles desde las bases
# archivadas.
tmp_*.txt
tmp_*.py
sweep_*.txt
